# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set to your MongoDB connection string (e.g. mongodb://127.0.0.1:27017/eshop or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/eshop

# Client URL (for CORS and cookie origin)
CLIENT_URL=http://localhost:3000

# Authentication (JWT)
JWT_SECRET=eshop_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=eshop_secure_cookie_secret_key_2026

# Admin Credentials for Seeding (Optional)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@eshop.com
ADMIN_PASSWORD=adminpassword123
